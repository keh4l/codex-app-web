# only ignore the top-level node_modules; scratch/asar/node_modules holds
# desktop-required native modules (node-pty / objc-js) and must be committed.
/node_modules/
# the unpacked desktop app (~850M) and downloaded zips are not committed;
# the patched scratch/asar (the actual frontend) IS committed.
scratch/Codex.app/
scratch/ChatGPT.app/
scratch/*.zip
sentry

# local env config (copy from .env.example)
.env

# browser console exports / misc logs dropped into the repo root for debugging
/*.log

# server build artifacts — regenerated by `npm run prepare` (build:server).
# Sources (*.ts) are tracked; these compiled outputs are not.
src/server/**/*.js
src/server/**/*.js.map
src/server/**/*.d.ts
src/server/**/*.d.ts.map

# --- AI coding tooling (BMAD / Serena / Graphify) ---
# Generated, regenerable scaffolding. Kept out of the tree so codex-web stays a
# thin wrapper that rebases cleanly onto upstream. Regenerate any time with:
#   npx bmad-method install            # _bmad/ + .claude/.agents skills
#   serena project index               # .serena/cache
#   graphify install / "/graphify ."   # graphify-out/
# Want to version BMAD config like the sibling `codex` repo? Remove _bmad/ below.


# macOS
.DS_Store
