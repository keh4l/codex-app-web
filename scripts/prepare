#!/usr/bin/env bash
set -euxo pipefail

if [[ -n "${HOSTED_CODEX_APP_ZIP:-}" ]]; then
  bash ./scripts/prepare_asar
  exit 0
fi

TEMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TEMP_DIR"' EXIT

APP_VERSION="26.715.72359"
APP_ARCHIVE_NAME="ChatGPT-darwin-arm64-$APP_VERSION.zip"
curl --fail --location --retry 5 --retry-all-errors --retry-delay 1 \
  --output "$TEMP_DIR/file.zip" \
  "https://persistent.oaistatic.com/codex-app-prod/$APP_ARCHIVE_NAME"

HOSTED_CODEX_APP_ZIP="$TEMP_DIR/file.zip" bash ./scripts/prepare_asar
