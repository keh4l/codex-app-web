#!/usr/bin/env bash
set -euxo pipefail

: "${HOSTED_CODEX_APP_ZIP:?HOSTED_CODEX_APP_ZIP must point to the official ChatGPT zip}"

APP_BUNDLE="scratch/ChatGPT.app"
APP_ASAR="$APP_BUNDLE/Contents/Resources/app.asar"

# Rebuild from a clean tree. Leaving the previous extracted asar in place can
# silently retain chunks that disappeared upstream and make a broken upgrade
# look healthy in development.
rm -rf scratch/asar scratch/Codex.app scratch/ChatGPT.app
mkdir -p scratch
unzip -o "$HOSTED_CODEX_APP_ZIP" -d scratch/
if [[ ! -f "$APP_ASAR" ]]; then
  echo "expected official app archive at $APP_ASAR" >&2
  exit 1
fi

asar extract "$APP_ASAR" "scratch/asar"

shopt -s nullglob
main_bundles=(scratch/asar/.vite/build/main-*.js)
shopt -u nullglob
if [[ ! -f scratch/asar/package.json || ! -f scratch/asar/webview/index.html || ! -f scratch/asar/.vite/build/preload.js || ${#main_bundles[@]} -ne 1 ]]; then
  echo "official app archive is missing an expected package, webview, preload, or unique main entry" >&2
  exit 1
fi

node -e '
  const fs = require("fs");
  const path = require("path");
  const packageJson = require("./scratch/asar/package.json");
  if (packageJson.version !== "26.715.72359") {
    throw new Error(`unexpected ChatGPT app version: ${packageJson.version}`);
  }
  if (
    typeof packageJson.main !== "string" ||
    !fs.existsSync(path.join("scratch/asar", packageJson.main))
  ) {
    throw new Error(`missing ChatGPT package main entry: ${packageJson.main}`);
  }
'

cp assets/* scratch/asar/webview/
PWA_SOURCE_ICON="scratch/asar/webview/assets/app-D0g8sCle.png"
PWA_TARGET_ICON="scratch/asar/webview/assets/pwa-icon-512.png"
PWA_ICON_SIZE=512
PWA_TOTAL_PADDING_PERCENT=25
PWA_CONTENT_SIZE=$((PWA_ICON_SIZE * (100 - PWA_TOTAL_PADDING_PERCENT) / 100))
PWA_PADDING_TOTAL=$((PWA_ICON_SIZE - PWA_CONTENT_SIZE))
PWA_PADDING_BEFORE=$((PWA_PADDING_TOTAL / 2))
PWA_PADDING_AFTER=$((PWA_PADDING_TOTAL - PWA_PADDING_BEFORE))
sharp -i "$PWA_SOURCE_ICON" -o "$PWA_TARGET_ICON" -f png resize "$PWA_CONTENT_SIZE" "$PWA_CONTENT_SIZE" --fit inside -- flatten white -- extend "$PWA_PADDING_BEFORE" "$PWA_PADDING_AFTER" "$PWA_PADDING_BEFORE" "$PWA_PADDING_AFTER" --background white -- removeAlpha
# Only format HTML (and other non-bundle sources). Prettier rewrites of large
# minified Vite/rolldown chunks can produce JS that V8/Chrome rejects with
# "Invalid destructuring assignment target" even when node --check passes.
if [[ -n "${DEV:-}" ]]; then
  prettier --ignore-path /dev/null --ignore-unknown --write \
    "scratch/asar/webview/index.html"
else
  patched_files=()
  while IFS= read -r patched_file; do
    case "$patched_file" in
      *.html) patched_files+=("$patched_file") ;;
    esac
  done < <(
    awk '/^\+\+\+ b\//{sub(/^\+\+\+ b\//, "scratch/asar/"); print}' patches/*.patch | sort -u
  )
  if [[ ${#patched_files[@]} -gt 0 ]]; then
    prettier --ignore-path /dev/null --ignore-unknown --write "${patched_files[@]}"
  fi
fi
apply_asar_patch() {
  patch --batch --forward -F 0 --strip 1 --directory scratch/asar < "$1"
}

if [[ -f patches/webview-style.patch ]]; then apply_asar_patch patches/webview-style.patch; fi
if [[ -f patches/webview-preload.patch ]]; then apply_asar_patch patches/webview-preload.patch; fi
if [[ -f patches/webview-favicon.patch ]]; then apply_asar_patch patches/webview-favicon.patch; fi
if [[ -f patches/webview-pwa.patch ]]; then apply_asar_patch patches/webview-pwa.patch; fi
if [[ -f patches/webview-thread-title.patch ]]; then apply_asar_patch patches/webview-thread-title.patch; fi
if [[ -f patches/webview-initial-route.patch ]]; then apply_asar_patch patches/webview-initial-route.patch; fi
if [[ -f patches/webview-electron-shim-close-sidebar.patch ]]; then apply_asar_patch patches/webview-electron-shim-close-sidebar.patch; fi
if [[ -f patches/webview-prosemirror-inputmode.patch ]]; then apply_asar_patch patches/webview-prosemirror-inputmode.patch; fi
if [[ -f patches/webview-use-atfs-for-local-files.patch ]]; then apply_asar_patch patches/webview-use-atfs-for-local-files.patch; fi
# prompt/statsig patches temporarily optional — re-enable after verified minified diffs
if [[ -f patches/webview-prompt-search-param.patch ]]; then
  apply_asar_patch patches/webview-prompt-search-param.patch
fi
if [[ -f patches/webview-app-host-services.patch ]]; then apply_asar_patch patches/webview-app-host-services.patch; fi
if [[ -f patches/webview-statsig-override-adapter.patch ]]; then
  apply_asar_patch patches/webview-statsig-override-adapter.patch
fi
if [[ -f patches/sentry-disable-shell.patch ]]; then apply_asar_patch patches/sentry-disable-shell.patch; fi
if [[ -f patches/sentry-disable-webview.patch ]]; then apply_asar_patch patches/sentry-disable-webview.patch; fi
# applied last: its context is generated against the fully-patched index.html
if [[ -f patches/webview-remove-csp.patch ]]; then apply_asar_patch patches/webview-remove-csp.patch; fi

patch_reject="$(find scratch/asar -type f -name '*.rej' -print -quit)"
if [[ -n "$patch_reject" ]]; then
  echo "patch left a reject file: $patch_reject" >&2
  exit 1
fi
find scratch/asar -type f -name '*.orig' -delete
rm -rf scratch/asar/node_modules/better-sqlite3

# 26.715+ main startup on darwin requires a complete bundled Git tree under
# process.resourcesPath/git. Browser hosting reuses system git via a thin
# wrapper so the check passes without shipping a full Git distribution.
mkdir -p \
  scratch/asar/git/bin \
  scratch/asar/git/etc \
  scratch/asar/git/libexec/git-core \
  scratch/asar/git/share/git-core/templates
printf '%s\n' '#!/bin/sh' 'exec git "$@"' > scratch/asar/git/bin/git
chmod +x scratch/asar/git/bin/git
if [[ ! -f scratch/asar/git/etc/gitconfig ]]; then
  printf '%s\n' '[user]' $'\t''name = codex-web' $'\t''email = codex-web@localhost' \
    > scratch/asar/git/etc/gitconfig
fi
